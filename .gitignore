cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.egg-info/
backend/.venv/
backend/db.sqlite3

# Environment files and secrets
.env
.env.*
!.env.example
backend/.env

# Node.js
node_modules/
frontend/dist/

# Build and test artifacts
coverage/

# Editors and operating systems
.vscode/
.DS_Store
EOF